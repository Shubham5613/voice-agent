# ElevenLabs
ELEVENLABS_API_KEY=sk_xxx
ELEVEN_VOICE_ID=            # pick an Indian-English voice in Voice Library, paste id; blank = fallback voice
ELEVEN_LLM=gemini-2.5-flash # or a claude-* value from the agent LLM dropdown
ELEVEN_TTS_MODEL=eleven_flash_v2_5

# Public URL of this backend (cloudflared/ngrok tunnel) so ElevenLabs can call the tools
PUBLIC_BASE_URL=https://xxxx.trycloudflare.com

# Local
PORT=8000
